    "## 2. 소견·클래스·학습 설정 고정\n",
    "\n",
    "Dataset 담당자와 순서를 맞춥니다. 255로 나눠 0~1로 바꾼 이미지에 채널별 평균·표준편차 정규화를 **한 번** 적용하는 규격입니다. 이 모델 코드는 입력에 정규화를 다시 적용하지 않습니다.\n",
    "\n",
    "시작 학습률은 `1e-4`, 모델 선택 기준은 **최소 검증 손실**입니다. 최적 설정이라는 뜻은 아닙니다. 재현성을 위해 DataLoader와 모델을 생성하기 전에 `set_seed()`를 호출합니다."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "29ba5a56",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "장치: cpu\n",
      "소견 순서: ['Cardiomegaly', 'Edema', 'Pleural Effusion']\n",
      "클래스 순서: ['negative', 'positive', 'uncertain']\n",
      "원본 → 학습 라벨: {0: 0, 1: 1, -1: 2}\n"
     ]
    }
   ],
   "source": [
    "TARGET_LABELS = [\"Cardiomegaly\", \"Edema\", \"Pleural Effusion\"]\n",
    "CLASS_NAMES = [\"negative\", \"positive\", \"uncertain\"]\n",
    "CLASS_MAP = {0: 0, 1: 1, -1: 2}\n",
    "IMAGE_SIZE = 224\n",
    "MEAN = [0.485, 0.456, 0.406]\n",
    "STD = [0.229, 0.224, 0.225]\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class TrainConfig:\n",
    "    # 시작 설정입니다. 최적값이 아니며 검증 결과와 GPU 환경에 따라 조정합니다.\n",
    "    epochs: int = 10\n",
    "    learning_rate: float = 1e-4\n",
    "    weight_decay: float = 1e-4\n",
    "    patience: int = 3\n",
    "    seed: int = 42\n",
    "    output_root: str = str(OUTPUT_ROOT)\n",
    "\n",
    "def set_seed(seed: int = 42) -> None:\n",
    "    \"\"\"실제 학습에서는 DataLoader와 모델을 만들기 전에 호출하세요.\"\"\"\n",
    "    random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    if torch.cuda.is_available():\n",
    "        torch.cuda.manual_seed_all(seed)\n",
    "    # 같은 환경에서 재현성을 높이는 설정. 모든 환경의 완전한 일치는 보장하지 않습니다.\n",
    "    torch.backends.cudnn.benchmark = False\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "\n",
    "def choose_device() -> torch.device:\n",
    "    return torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "set_seed(42)\n",
    "device = choose_device()\n",
    "print("사용 장치:", device)\n",
    "if device.type == \"cpu\":\n",
    "    torch.set_num_threads(min(4, torch.get_num_threads()))\n",
    "print(\"장치:\", device)\n",
    "print(\"소견 순서:\", TARGET_LABELS)\n",
    "print(\"클래스 순서:\", CLASS_NAMES)\n",
    "print(\"원본 → 학습 라벨:\", CLASS_MAP)"
   ]
  },
